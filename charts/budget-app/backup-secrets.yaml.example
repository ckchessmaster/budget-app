# Example Secrets for Milestone 7 opt-in Backup CronJob & W3C Web Push (VAPID).
# Copy, populate real values out-of-band (never commit secrets), and apply before
# enabling backup.enabled=true or vapid.enabled=true in Helm.
#
# 1. Generate an asymmetric age keypair offline (keep the private key OFF the cluster):
#      age-keygen -o budget-backup-age-identity.txt
#      # Note the public key line:  # public key: age1...
#      # Store budget-backup-age-identity.txt in a password manager / hardware backup.
#
# 2. Create rclone.conf locally (e.g., `rclone config` for remote `gdrive`) and
#    embed it in the Secret below, or create it directly with kubectl:
#      kubectl create secret generic budget-backup-rclone \
#        --from-file=rclone.conf="$HOME/.config/rclone/rclone.conf"
#
# 3. Generate VAPID keys if enabling Web Push notifications:
#      npx web-push generate-vapid-keys
#
# 4. Install / upgrade with Helm:
#      helm upgrade --install budget-app ./charts/budget-app \
#        --set temporal.address=temporal-frontend.temporal.svc.cluster.local:7233 \
#        --set vault.existingSecret=budget-backend-secrets \
#        --set backup.enabled=true \
#        --set backup.agePublicKey=age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p \
#        --set backup.rclone.existingSecret=budget-backup-rclone \
#        --set vapid.enabled=true \
#        --set vapid.existingSecret=budget-vapid-secrets
---
apiVersion: v1
kind: Secret
metadata:
  name: budget-backup-rclone
type: Opaque
stringData:
  rclone.conf: |
    [gdrive]
    type = drive
    scope = drive.file
    token = {"access_token":"REPLACE_ME","token_type":"Bearer","refresh_token":"REPLACE_ME","expiry":"2026-01-01T00:00:00Z"}
---
apiVersion: v1
kind: Secret
metadata:
  name: budget-vapid-secrets
type: Opaque
stringData:
  VAPID_PUBLIC_KEY: "REPLACE_WITH_URL_SAFE_BASE64_PUBLIC_KEY"
  VAPID_PRIVATE_KEY: "REPLACE_WITH_URL_SAFE_BASE64_PRIVATE_KEY"
  VAPID_SUBJECT: "mailto:ops@example.com"
