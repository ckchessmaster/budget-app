# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/budgetdb?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=budgetdb
POSTGRES_PORT=5432

# Backend API Configuration
PORT=8080
APP_ENV=development

# Temporal Orchestration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Authentication & OIDC
# Local development uses Dex; Production uses Authentik
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_CLIENT_ID=budget-app-client
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Banking Aggregation (SimpleFIN)
SIMPLEFIN_CLAIM_URL=
SIMPLEFIN_ACCESS_URL=
ENCRYPTION_KEY= # 32-byte AES-GCM encryption key for sensitive tokens

# Receipt Ingestion
CLOUDFLARE_WEBHOOK_SECRET=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:7b

# Push Notifications (W3C VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Backup Configuration (Disaster Recovery)
AGE_PUBLIC_KEY=
RCLONE_DESTINATION=gdrive:Backups/budget-app
