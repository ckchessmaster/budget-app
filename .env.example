# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/budgetdb?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=budgetdb
POSTGRES_PORT=5432

# Backend API Configuration
PORT=8080
APP_ENV=development

# Temporal Orchestration (required)
# Bank sync runs as a Temporal workflow. The API exits at boot when the server cannot be
# reached and reports unready when the namespace stops resolving, so both of these have to
# be right before anything serves traffic. The API registers the namespace on boot when it
# is missing, which keeps budget-app off the shared "default" namespace.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=budget-app
# How long completed workflow history stays queryable.
TEMPORAL_RETENTION=72h

# Authentication & OIDC
# Local development uses Dex; Production uses Authentik
OIDC_ISSUER_URL=http://localhost:5556/dex
# Optional. When set, the API also requires this value in the token's "aud" claim.
# Leave unset to skip the audience check (signature, issuer and expiry are always
# verified regardless). Production sets this through the Helm chart.
OIDC_CLIENT_ID=
# Emergency escape hatch to stop audience verification without a new image.
# Only set this to false if the identity provider issues this client a token whose
# audience is not OIDC_CLIENT_ID. Signature/issuer/expiry stay enforced.
OIDC_ENFORCE_AUDIENCE=true
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# Cross-Origin Resource Sharing
# Comma-separated browser origins allowed to call the API from another site.
# Requests with no Origin header (curl, health probes, and the same-origin
# traffic the frontend's nginx proxies in production) are never affected.
# Unset means no cross-site access is granted at all. The Vite dev server is a
# different origin from the API, so local development needs these.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo SimpleFIN Bridge (built into the API process)
# The bridge that backs demo bank data binds loopback by default, so it is not
# reachable from other pods and is absent from the public router. Leave these unset
# unless a Temporal sync worker runs in a separate pod, in which case bind a routable
# address and point the base URL at it from that worker's environment too.
MOCK_SIMPLEFIN_LISTEN_ADDR=
MOCK_SIMPLEFIN_BASE_URL=

# Banking Aggregation (SimpleFIN)
SIMPLEFIN_CLAIM_URL=
SIMPLEFIN_ACCESS_URL=
# Required. Base64 of exactly 32 random bytes: openssl rand -base64 32
# Seals stored SimpleFIN credentials with AES-256-GCM. There is no fallback key: a missing
# or malformed value stops the API and the sync worker from starting. The API and the
# worker must be given the same value, and rotating it invalidates every stored value, so
# clear simplefin_connections and re-claim afterwards.
VAULT_MASTER_KEY=

# Receipt Ingestion
CLOUDFLARE_WEBHOOK_SECRET=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:7b

# Push Notifications (W3C VAPID, opt-in)
# Leave all three unset to disable Web Push cleanly. When enabled, all three must be
# provided and VAPID_SUBJECT must start with mailto: or https:// (e.g. mailto:admin@example.com).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Backup Configuration (Disaster Recovery, opt-in)
# Asymmetric age public recipient key ONLY (age1..., 62 chars); never place AGE-SECRET-KEY-* on the cluster.
AGE_PUBLIC_KEY=
RCLONE_CONFIG=/etc/rclone/rclone.conf
RCLONE_REMOTE=gdrive:HomelabBackups/BudgetApp/
BACKUP_PREFIX=budget_backup
BACKUP_TMPDIR=/tmp
RCLONE_RETRIES=3

# Household Invitations & Identity Provisioning (opt-in)
# Leave RESEND_API_KEY and AUTHENTIK_API_TOKEN unset in local dev to use console logging + Dex deterministic UUIDs.
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=Budget App <invites@dev.local>
RESEND_API_KEY=
APP_PUBLIC_URL=http://localhost:5173
IDP_PROVISIONING_PROVIDER=authentik
AUTHENTIK_BASE_URL=
AUTHENTIK_API_TOKEN=

# Platform Admin Access Control
# JWT `groups` claim required for /api/v1/admin/* and /admin UI.
PLATFORM_ADMIN_GROUP=budget-admins
# Optional comma-separated fallback emails for local Dex development (leave unset in production).
PLATFORM_ADMIN_EMAILS=
